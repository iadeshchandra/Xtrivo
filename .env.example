# XTRIVO environment variables — copy to .env for local development.
# NEVER commit real secrets. Production secrets live in GitHub Actions secrets.
#
# XTRIVO build tooling sends no telemetry. Ever.
# (Astro telemetry is disabled via ASTRO_TELEMETRY_DISABLED=1 in apps/web
#  package.json and CI — a privacy-conscious product doesn't phone home.)
ASTRO_TELEMETRY_DISABLED=1

# Web (Firebase Hosting deploy — Stage 7)
# FIREBASE_PROJECT_ID=xtrivo-web
# FIREBASE_SERVICE_ACCOUNT=<set via GitHub Actions secret, never here>
#
# Android release signing (Stage 11 — owner-generated keystore, off-repo)
# ANDROID_KEYSTORE_BASE64=<GitHub Actions secret only>
# ANDROID_KEYSTORE_PASSWORD=<GitHub Actions secret only>
# ANDROID_KEY_ALIAS=<GitHub Actions secret only>
# ANDROID_KEY_PASSWORD=<GitHub Actions secret only>
#
# Desktop auto-update feed (Stage 6+, optional)
# UPDATE_FEED_URL=
